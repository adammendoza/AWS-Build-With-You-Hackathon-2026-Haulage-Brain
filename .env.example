# You.com live grounding
YDC_API_KEY=
YDC_SEARCH_URL=https://ydc-index.io/v1/search

# Parasail inference
PARASAIL_API_KEY=
PARASAIL_BASE_URL=https://api.parasail.io/v1
PARASAIL_MODEL=parasail-glm-53-flash
PARASAIL_MAX_CONCURRENCY=8
# Keep these aligned with the selected model's live Parasail catalog price.
PARASAIL_INPUT_USD_PER_MILLION=0.15
PARASAIL_OUTPUT_USD_PER_MILLION=0.50

# One / Discord (resolve action IDs at runtime; do not hardcode them)
ONE_SECRET=
ONE_DISCORD_CONNECTION_KEY=
ONE_DISCORD_CHANNEL_ID=
